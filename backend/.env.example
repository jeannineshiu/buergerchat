# Local dev default (no Postgres set up yet): sqlite:///data/metadata.db
# Production target: postgresql://user:password@localhost:5432/buergerchat
DATABASE_URL=sqlite:///data/metadata.db
# Directory holding the built artifacts (faiss_index.bin + metadata.db).
# Relative paths are anchored to the repo root; on Railway this is the
# volume mount, /data (set in backend/Dockerfile).
DATA_DIR=data
# Optional override for the index file itself; wins over DATA_DIR.
# FAISS_INDEX_PATH=data/faiss_index.bin
OPENAI_API_KEY=
# Optional: override the answer model (default gpt-5.4-mini, see rag.py).
# CHAT_MODEL=gpt-5.4-mini
# Production only: deployed frontend origin, added to CORS allowlist.
# FRONTEND_ORIGIN=https://frontend-xxxx.up.railway.app
